<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_voucher_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="voucher_title" t-value="{
                        'receipt': 'Receipt Voucher',
                        'payment': 'Payment Voucher',
                        'contra': 'Contra Voucher',
                        'expense': 'Expense Voucher',
                        'journal': 'Journal Voucher',
                    }.get(o.voucher_type, 'Voucher')"/>
                    <t t-set="partner_label" t-value="{
                        'receipt': 'Customer',
                        'payment': 'Vendor',
                    }.get(o.voucher_type, 'Partner')"/>

                    <div class="page" style="font-family: Arial, sans-serif; font-size:12px; padding-top:15mm;">
                        <h2 style="text-align:center; font-size:28px; font-weight:bold; margin:0 0 25px 0;">
                            <span t-esc="voucher_title"/>
                        </h2>

                        <table style="width:100%; border-collapse:collapse;">
                            <tbody>
                                <tr>
                                    <td style="border:1px solid #000; width:20%; padding:9px;"><b>Voucher No.</b></td>
                                    <td style="border:1px solid #000; width:30%; padding:9px;"><span t-field="o.voucher_number"/></td>
                                    <td style="border:1px solid #000; width:20%; padding:9px;"><b>Date</b></td>
                                    <td style="border:1px solid #000; width:30%; padding:9px;"><span t-field="o.date"/></td>
                                </tr>

                                <tr t-if="o.partner_id">
                                    <td style="border:1px solid #000; padding:9px;"><b><span t-esc="partner_label"/></b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.partner_id"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><b>Status</b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.state"/></td>
                                </tr>

                                <tr t-if="not o.partner_id">
                                    <td style="border:1px solid #000; padding:9px;"><b>Status</b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.state"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><b>Currency</b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.currency_id"/></td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid #000; padding:9px;"><b>Created By</b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.created_by"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><b>Company</b></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.company_id"/></td>
                                </tr>

                                <tr t-if="o.voucher_type != 'journal'">
                                    <td style="border:1px solid #000; padding:9px;"><b>Amount</b></td>
                                    <td style="border:1px solid #000; padding:9px; font-weight:bold;"><span t-field="o.amount_total"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><b>Payment Mode</b></td>
                                    <td style="border:1px solid #000; padding:9px;">
                                        <span t-field="o.payment_mode" t-if="o.voucher_type in ('receipt', 'payment', 'expense')"/>
                                        <span t-else="">-</span>
                                    </td>
                                </tr>

                                <tr t-if="o.voucher_type != 'journal'">
                                    <td style="border:1px solid #000; padding:9px;"><b>Amount In Words</b></td>
                                    <td colspan="3" style="border:1px solid #000; padding:9px;">
                                        <i><span t-esc="o.currency_id.amount_to_text(o.amount_total)"/> Only</i>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid #000; padding:9px;"><b>Narration</b></td>
                                    <td colspan="3" style="border:1px solid #000; padding:9px;"><span t-esc="o.narration or ''"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.invoice_id">
                            <h3 style="margin-top:24px; margin-bottom:8px;">Reference</h3>
                            <table style="width:100%; border-collapse:collapse;">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid #000; padding:9px;">Document</th>
                                        <th style="border:1px solid #000; padding:9px;">Date</th>
                                        <th style="border:1px solid #000; padding:9px;">Total</th>
                                        <th style="border:1px solid #000; padding:9px;">Residual</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border:1px solid #000; padding:9px;"><span t-field="o.invoice_id.name"/></td>
                                        <td style="border:1px solid #000; padding:9px;"><span t-field="o.invoice_id.invoice_date"/></td>
                                        <td style="border:1px solid #000; padding:9px;"><span t-field="o.invoice_id.amount_total"/></td>
                                        <td style="border:1px solid #000; padding:9px;"><span t-field="o.invoice_id.amount_residual"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <h3 style="margin-top:24px; margin-bottom:8px;">Accounting Details</h3>

                        <table t-if="o.voucher_type == 'journal'" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #000; padding:9px;">Account</th>
                                    <th style="border:1px solid #000; padding:9px;">Partner</th>
                                    <th style="border:1px solid #000; padding:9px;">Label</th>
                                    <th style="border:1px solid #000; padding:9px; text-align:right;">Debit</th>
                                    <th style="border:1px solid #000; padding:9px; text-align:right;">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="line.account_id"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="line.partner_id"/></td>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="line.name"/></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><span t-field="line.debit"/></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><span t-field="line.credit"/></td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="border:1px solid #000; padding:9px; text-align:right;"><b>Total</b></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><b><span t-field="o.total_debit"/></b></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><b><span t-field="o.total_credit"/></b></td>
                                </tr>
                            </tbody>
                        </table>

                        <table t-else="" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #000; padding:9px;">Account</th>
                                    <th style="border:1px solid #000; padding:9px; text-align:right;">Debit</th>
                                    <th style="border:1px solid #000; padding:9px; text-align:right;">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.debit_account_id"/></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><span t-field="o.amount_total"/></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;">0.00</td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #000; padding:9px;"><span t-field="o.credit_account_id"/></td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;">0.00</td>
                                    <td style="border:1px solid #000; padding:9px; text-align:right;"><span t-field="o.amount_total"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top:70px; page-break-inside:avoid;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="width:33%; text-align:center;">_______________________<br/>Prepared By</td>
                                    <td style="width:33%; text-align:center;">_______________________<br/>Approved By</td>
                                    <td style="width:33%; text-align:center;">_______________________<br/>Authorized Signature</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
