<odoo>
  <record id="module_category_voucher" model="ir.module.category">
    <field name="name">Voucher Management</field>
    <field name="sequence">30</field>
  </record>
  <record id="group_voucher_user" model="res.groups">
    <field name="name">Voucher User</field><field name="category_id" ref="module_category_voucher"/>
    <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
  </record>
  <record id="group_voucher_approver" model="res.groups">
    <field name="name">Voucher Approver</field><field name="category_id" ref="module_category_voucher"/>
    <field name="implied_ids" eval="[(4, ref('group_voucher_user'))]"/>
  </record>
  <record id="group_voucher_manager" model="res.groups">
    <field name="name">Voucher Accountant/Manager</field><field name="category_id" ref="module_category_voucher"/>
    <field name="implied_ids" eval="[(4, ref('group_voucher_approver')), (4, ref('account.group_account_invoice'))]"/>
  </record>
  <record id="voucher_company_rule" model="ir.rule">
    <field name="name">Voucher: allowed companies</field><field name="model_id" ref="model_account_voucher"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_voucher_user'))]"/>
  </record>
  <record id="voucher_line_company_rule" model="ir.rule">
    <field name="name">Voucher lines: allowed companies</field><field name="model_id" ref="model_account_voucher_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_voucher_user'))]"/>
  </record>
</odoo>
